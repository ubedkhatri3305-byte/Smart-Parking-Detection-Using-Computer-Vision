# ==============================================================================
# Smart Parking Detection Using Computer Vision - Environment Configuration
# ==============================================================================

# Server Network Settings
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Ultralytics YOLOv8 Neural Model Configuration
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONF_THRESHOLD=0.25
YOLO_DEVICE=cpu

# Map & Geolocation Settings
# Real Map Tile Server (OpenStreetMap default / Mapbox or Google Maps optional)
MAP_PROVIDER=openstreetmap
# MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
# GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Academic Demo & Prototype Settings
DEMO_MODE=true
DEFAULT_HUB_CITY=mumbai

# CORS Security
CORS_ORIGINS=*
